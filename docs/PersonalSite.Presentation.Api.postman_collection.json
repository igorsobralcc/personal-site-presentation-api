  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7211", "type": "string" },
    { "key": "adminKey", "value": "", "type": "string" },
    { "key": "page", "value": "1", "type": "string" },
    { "key": "pageSize", "value": "20", "type": "string" },
    { "key": "includeDeleted", "value": "false", "type": "string" },
    { "key": "presentationEtag", "value": "", "type": "string" },
    { "key": "profileEtag", "value": "", "type": "string" },
    { "key": "experienceId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" },
    { "key": "experienceEtag", "value": "", "type": "string" },
    { "key": "projectId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" },
