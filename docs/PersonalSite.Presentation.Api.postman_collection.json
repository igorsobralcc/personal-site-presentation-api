          "request": {
            "method": "PUT",
            "header": [{ "key": "X-Admin-Key", "value": "{{adminKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Igor Sobral\",\n  \"headline\": \"Software Engineer | .NET | Distributed Systems | AWS & Azure\",\n  \"biography\": \"Backend software engineer specializing in reliable distributed systems.\",\n  \"shortSummary\": \"Open to mid-level opportunities worldwide.\",\n  \"location\": \"Brazil\",\n  \"email\": null,\n  \"availability\": \"Open to mid-level backend software engineering opportunities worldwide.\",\n  \"currentFocus\": \"Building scalable backend platforms with .NET.\",\n  \"socialLinks\": [\n    { \"label\": \"GitHub\", \"url\": \"https://github.com/igorsobralcc\" },\n    { \"label\": \"LinkedIn\", \"url\": \"https://www.linkedin.com/in/igor-sobral-m\" }\n  ]\n}" },
            "url": "{{baseUrl}}/api/v1/admin/profile"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const etag = pm.response.headers.get('ETag');", "if (etag) pm.collectionVariables.set('profileEtag', etag);"] } }]
        },
        {
          "name": "Patch profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "X-Admin-Key", "value": "{{adminKey}}" }, { "key": "If-Match", "value": "{{profileEtag}}" }, { "key": "Content-Type", "value": "application/merge-patch+json" }],
            "body": { "mode": "raw", "raw": "{\n  \"availability\": \"Open to mid-level backend software engineering opportunities worldwide.\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/profile"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const etag = pm.response.headers.get('ETag');", "if (etag) pm.collectionVariables.set('profileEtag', etag);"] } }]
        }
