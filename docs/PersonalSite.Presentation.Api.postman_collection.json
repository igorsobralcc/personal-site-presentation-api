  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const etag = pm.response.headers.get('ETag');",
          "if (etag) {",
          "  const path = pm.request.url.getPath();",
          "  if (path.includes('/experiences/')) pm.collectionVariables.set('experienceEtag', etag);",
          "  else if (path.includes('/projects/')) pm.collectionVariables.set('projectEtag', etag);",
          "  else if (path.includes('/skill-categories/')) pm.collectionVariables.set('skillCategoryEtag', etag);",
          "  else if (path.includes('/skills/')) pm.collectionVariables.set('skillEtag', etag);",
          "  else if (path.includes('/technologies/')) pm.collectionVariables.set('technologyEtag', etag);",
          "  else if (path.endsWith('/admin/profile')) pm.collectionVariables.set('profileEtag', etag);",
          "  else if (path.endsWith('/presentation')) pm.collectionVariables.set('presentationEtag', etag);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Presentation",
      "item": [
        {
          "name": "Get current public portfolio",
          "request": {
            "method": "GET",
            "header": [{ "key": "If-None-Match", "value": "{{presentationEtag}}", "disabled": true }],
            "url": "{{baseUrl}}/api/v1/presentation",
            "description": "Returns the current public presentation. Enable If-None-Match to exercise conditional caching."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const etag = pm.response.headers.get('ETag');", "if (etag) pm.collectionVariables.set('presentationEtag', etag);"] } }]
        }
      ]
    },
